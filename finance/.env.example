# Railway injects DATABASE_URL and PORT automatically in production.
# For local development, either set DATABASE_URL to a running Postgres instance…
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/mancuso_tracker

# …or set the individual PG* vars (used when DATABASE_URL is unset):
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=mancuso_tracker

PORT=3000
NODE_ENV=development
